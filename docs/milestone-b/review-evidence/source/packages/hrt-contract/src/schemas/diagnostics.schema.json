{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eshop.local/hrt-contract/diagnostics.schema.json",
  "title": "HRT Diagnostics Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosticCode",
    "severity",
    "reason",
    "redactedDetails",
    "correlationId",
    "providerInstanceId",
    "timestamp"
  ],
  "properties": {
    "diagnosticCode": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["INFO", "WARN", "ERROR"] },
    "reason": { "type": "string", "minLength": 1 },
    "redactedDetails": { "type": "object" },
    "correlationId": { "type": "string", "minLength": 1 },
    "providerInstanceId": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
