[Unit]
Description=Isolated H5 renderer controller candidate
After=network-online.target h5-render-sandbox.socket
Wants=network-online.target h5-render-sandbox.socket
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=h5-render-controller
Group=h5-render-socket
ExecStart=/opt/es-h5-node/bin/node /opt/eshop-h5-renderer/arm64-integration-r1/controller.mjs
EnvironmentFile=/etc/eshop-h5-renderer/controller.env
LoadCredential=worker-token:/etc/eshop-h5-renderer/worker-token
Restart=on-failure
RestartSec=5
MemoryMax=256M
MemorySwapMax=0
CPUQuota=25%
TasksMax=32
KillMode=control-group
TimeoutStopSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
LogRateLimitIntervalSec=60
LogRateLimitBurst=30
StandardOutput=journal
StandardError=journal
UMask=0077

[Install]
WantedBy=multi-user.target
