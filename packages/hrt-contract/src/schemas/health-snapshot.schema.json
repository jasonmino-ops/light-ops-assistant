{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eshop.local/hrt-contract/health-snapshot.schema.json",
  "title": "HRT Health Snapshot Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["providerHealth", "providerInstanceId", "timestamp", "devices"],
  "properties": {
    "providerHealth": {
      "enum": ["UNKNOWN", "STARTING", "READY", "DEGRADED", "DISCONNECTED", "SHUTDOWN"]
    },
    "providerInstanceId": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["device", "health", "capabilities"],
        "properties": {
          "device": { "type": "object" },
          "health": { "enum": ["UNKNOWN", "ONLINE", "DEGRADED", "OFFLINE"] },
          "capabilities": { "type": "array" }
        }
      }
    }
  }
}
