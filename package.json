{
  "name": "light-ops-assistant",
  "version": "1.0.0",
  "description": "门店轻经营助手 SaaS v1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:smoke:prod": "playwright test tests/smoke/production-smoke.spec.ts",
    "release:windows": "npm --prefix desktop run release:windows",
    "postinstall": "prisma generate",
    "migrate:prod": "DATABASE_URL=$DIRECT_URL prisma migrate deploy",
    "rollback:freeze": "bash scripts/rollback-to-freeze.sh",
    "vercel:deployments": "vercel ls",
    "vercel:deployments:json": "vercel ls light-ops-assistant --format=json",
    "vercel:production": "vercel inspect https://light-ops-assistant.vercel.app",
    "vercel:current": "node scripts/vercel-current.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@eshop/hrt-contract": "file:packages/hrt-contract",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@zxing/browser": "^0.1.5",
    "html2canvas": "^1.4.1",
    "next": "^15.3.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.0.18",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^7.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vercel": "^54.14.0"
  }
}
