/// 手机 /sale ↔ 电脑 /desktop 同屏联动：每店仅一条 active 草稿会话。
/// 手机端在 cart/payStep/success 变化时 fire-and-forget upsert；
/// 电脑端 /desktop?storeCode= 每 1.5s GET 同一行做镜像展示。
/// 与 SaleRecord / PaymentIntent 主交易链路完全解耦：本表不承载任何业务真相，
/// 仅是 UI 镜像；丢失数据不影响最终销售记录。
model PosSession {
  id             String    @id @default(cuid())
  tenantId       String
  storeId        String
  storeCode      String // 反查用，避免每次 desktop GET 都 JOIN Store
  operatorUserId String? // 最后一次更新的操作员
  status         String    @default("DRAFT") // DRAFT | AWAITING_PAYMENT | COMPLETED | CANCELLED
  paymentMethod  String? // CASH | KHQR
  paymentStatus  String? // PENDING | PAID
  itemsJson      String    @default("[]") @db.Text // [{productId,name,spec,price,qty,lineAmount}]
  totalAmount    Decimal   @default(0) @db.Decimal(12, 2)
  itemCount      Int       @default(0)
  khqrPayload    String?   @db.Text
  khqrImageUrl   String?   @db.Text
  orderNo        String? // 完成时回填，desktop 展示用
  message        String?   @db.Text // 给 desktop 的提示文案，可选
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, storeId])
  @@index([storeCode])
  @@index([updatedAt])
}

model DesktopDevice {
  id                 String              @id @default(cuid())
  tenantId           String
  storeId            String
  installationIdHash String
  status             DesktopDeviceStatus @default(ACTIVE)
  activeSlot         String?             @default("ACTIVE")
  tokenHash          String              @unique
  tokenHashVersion   Int                 @default(1)
  tokenVersion       Int                 @default(1)
  tokenIssuedAt      DateTime
  tokenExpiresAt     DateTime
  tokenLastUsedAt    DateTime?
  lastSeenAt         DateTime?
  activatedAt        DateTime            @default(now())
  revokedAt          DateTime?
  revokedByUserId    String?
  revocationReason   String?             @db.Text
  replacesDeviceId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  revokedByUser     User?                    @relation("DesktopDeviceRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  replacesDevice    DesktopDevice?           @relation("DesktopDeviceReplacement", fields: [replacesDeviceId], references: [id], onDelete: SetNull)
  replacedByDevices DesktopDevice[]          @relation("DesktopDeviceReplacement")
  usedPins          DesktopActivationPin[]   @relation("DesktopActivationPinUsedByDevice")
  audits            DesktopActivationAudit[]

  @@unique([installationIdHash, activeSlot])
  @@index([tenantId, storeId])
  @@index([storeId, status])
  @@index([installationIdHash])
  @@index([tokenExpiresAt])
  @@index([revokedByUserId])
  @@index([replacesDeviceId])
}

model BrowserPosDevice {
  id               String                 @id @default(cuid())
  tenantId         String
  storeId          String
  browserDeviceId  String
  displayName      String?
  browserInfo      String?                @db.Text
  status           BrowserPosDeviceStatus @default(ACTIVE)
  activeSlot       String?                @default("ACTIVE")
  tokenHash        String                 @unique
  tokenHashVersion Int                    @default(1)
  tokenIssuedAt    DateTime
  tokenExpiresAt   DateTime
  scopes           Json
  issuedByUserId   String?
  activatedAt      DateTime               @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  revokedByUserId  String?
  revocationReason String?                @db.Text
  legacyMigratedAt DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  issuedByUser      User?                       @relation("BrowserPosDeviceIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  revokedByUser     User?                       @relation("BrowserPosDeviceRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  bindingDeliveries BrowserPosBindingDelivery[]

  @@unique([storeId, browserDeviceId, activeSlot])
  @@index([tenantId, storeId])
  @@index([storeId, status])
  @@index([browserDeviceId])
  @@index([tokenExpiresAt])
  @@index([issuedByUserId])
  @@index([revokedByUserId])
}

model BrowserPosBindingDelivery {
  id                 String   @id @default(cuid())
  tenantId           String
  storeId            String
  requestId          String   @unique
  browserDeviceId    String
  bindingAttemptId   String
  browserPosDeviceId String
  status             String   @default("READY")
  encryptedResult    String   @db.Text
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  browserPosDevice BrowserPosDevice @relation(fields: [browserPosDeviceId], references: [id], onDelete: Cascade)

  @@unique([requestId, browserDeviceId, bindingAttemptId], map: "BrowserPosBindingDelivery_request_device_attempt_key")
  @@index([tenantId, storeId])
  @@index([expiresAt])
}

model DesktopActivationPin {
  id              String                     @id @default(cuid())
  tenantId        String
  storeId         String
  pinHash         String
  pinHashVersion  Int                        @default(1)
  status          DesktopActivationPinStatus @default(ACTIVE)
  activeSlot      String?                    @default("ACTIVE")
  expiresAt       DateTime
  usedAt          DateTime?
  usedByDeviceId  String?
  failedAttempts  Int                        @default(0)
  lockedUntil     DateTime?
  createdByUserId String
  revokedAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdByUser User                     @relation("DesktopActivationPinCreatedByUser", fields: [createdByUserId], references: [id])
  usedByDevice  DesktopDevice?           @relation("DesktopActivationPinUsedByDevice", fields: [usedByDeviceId], references: [id], onDelete: SetNull)
  audits        DesktopActivationAudit[]

  @@unique([storeId, activeSlot])
  @@index([tenantId, storeId])
  @@index([expiresAt])
  @@index([usedByDeviceId])
  @@index([createdByUserId])
  @@index([status])
}

model DesktopActivationAudit {
  id            String   @id @default(cuid())
  tenantId      String
  storeId       String
  deviceId      String?
  pinId         String?
  actorUserId   String?
  eventType     String
  result        String
  reasonCode    String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime @default(now())

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  device    DesktopDevice?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  pin       DesktopActivationPin? @relation(fields: [pinId], references: [id], onDelete: SetNull)
  actorUser User?                 @relation("DesktopActivationAuditUserActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([storeId, createdAt])
  @@index([deviceId, createdAt])
  @@index([pinId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@index([result, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// EP-CC-01 电脑客户端绑定（Windows Agent V0.4 ↔ E-Shop Cloud）
//
// 与旧 Desktop PIN 激活链路、Browser POS Device Token 完全隔离：
// 独立表、独立密钥（COMPUTER_CLIENT_TOKEN_SECRET）、独立凭证前缀。
//
// 凭证明文（claimSecret / deviceSecret）由 Agent 本地生成并保存，
// 云端只保存 HMAC 哈希，任何时候都不落库、不写日志。
// ─────────────────────────────────────────────────────────────────────────────

model ComputerBinding {
  id       String @id @default(cuid())
  tenantId String
  storeId  String

  // 安装实例身份（哈希存储）。一个安装实例一行，作为幂等键。
  installationIdHash String @unique

  // 申请信息（客户端上报，仅作展示与投递线索，不构成授权）
  computerName String
  agentVersion String?
  deviceInfo   Json?

  status      ComputerBindingStatus @default(PENDING)
  requestedAt DateTime              @default(now())
  expiresAt   DateTime // PENDING 超时后惰性判定为 EXPIRED

  // 申请通道凭证（claimSecret）哈希：提交 / 查询 / 取消
  claimSecretHash    String
  claimSecretVersion Int    @default(1)

  // 设备通道凭证（deviceSecret）哈希：批准后用于确认绑定
  deviceSecretHash      String
  deviceSecretVersion   Int                      @default(1)
  credentialStatus      ComputerCredentialStatus @default(PENDING)
  credentialActivatedAt DateTime?
  credentialExpiresAt   DateTime?

  // 审批与绑定结果
  decidedByUserId  String?
  decidedAt        DateTime?
  boundAt          DateTime? // 设备用 deviceSecret 确认绑定的时间
  lastSeenAt       DateTime?
  disabledByUserId String?
  disabledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // 复合外键：数据库层面保证 storeId 必须属于 tenantId，
  // 杜绝「绑定记录的门店不属于该租户」这类非法组合。
  store                Store                         @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  decidedByUser        User?                         @relation("ComputerBindingDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  disabledByUser       User?                         @relation("ComputerBindingDisabledBy", fields: [disabledByUserId], references: [id], onDelete: SetNull)
  audits               ComputerBindingAudit[]
  browserLaunchTickets ComputerBrowserLaunchTicket[]

  @@index([tenantId, storeId, status])
  @@index([tenantId, storeId, disabledAt])
  @@index([storeId, status, requestedAt])
  @@index([status, expiresAt])
  @@index([decidedByUserId])
  @@index([disabledByUserId])
}

// Agent 进入 Browser POS 使用的一次性短票据。
// 浏览器只提交明文一次；数据库仅保存 HMAC 哈希，兑换后 usedAt 原子落库。
model ComputerBrowserLaunchTicket {
  id                  String    @id @default(cuid())
  bindingId           String
  ticketHash          String    @unique
  expiresAt           DateTime
  usedAt              DateTime?
  browserDeviceIdHash String?
  browserPosDeviceId  String?
  createdAt           DateTime  @default(now())

  binding ComputerBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([bindingId, createdAt])
  @@index([expiresAt])
}

model ComputerBindingAudit {
  id            String   @id @default(cuid())
  tenantId      String
  storeId       String
  bindingId     String?
  actorUserId   String?
  eventType     String
  result        String // SUCCESS | FAILED | DENIED | INFO
  reasonCode    String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  createdAt     DateTime @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  binding   ComputerBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)
  actorUser User?            @relation("ComputerBindingAuditUserActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([storeId, createdAt])
  @@index([bindingId, createdAt])
  @@index([eventType, createdAt])
  @@index([result, createdAt])
}
