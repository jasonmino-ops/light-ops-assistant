generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StoreStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  ACTIVE
  DISABLED
}

enum MarketingProductPageStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum MarketingProductPageTemplateType {
  TIKTOK_HOT
  HOME_GOODS
  FOOD_SET
  BEAUTY
}

enum SaleType {
  SALE
  REFUND
}

enum RecordStatus {
  PENDING_PAYMENT // 已建单，待收款（零售 KHQR 挂单 / 未来餐饮预留）
  COMPLETED // 已完成（含收款确认）
  CANCELLED // 已取消（含 KHQR 超时/主动取消）
}

enum PaymentMethod {
  CASH
  KHQR
  MEMBER_BALANCE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

enum LogStatus {
  SUCCESS
  FAILED
}

enum DesktopDeviceStatus {
  ACTIVE
  REVOKED
}

enum BrowserPosDeviceStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum DesktopActivationPinStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

// EP-CC-01 电脑客户端（Windows Agent V0.4）绑定申请状态。
// 与旧 Desktop PIN 激活链路完全独立：不同表、不同密钥、不同 token 前缀。
enum ComputerBindingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

// 设备凭证状态。凭证明文由 Agent 本地生成，云端只存哈希。
// PENDING：已登记未激活，禁止使用；ACTIVE：OWNER 批准后可用于确认绑定。
enum ComputerCredentialStatus {
  PENDING
  ACTIVE
  VOID
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum MemberBalanceLedgerType {
  IMPORT
  RECHARGE
  CONSUME
  REFUND
  ADJUST
}

enum MemberBalanceLedgerSourceType {
  IMPORT
  SALE_RECORD
  MANUAL_RECHARGE
  MANUAL_ADJUST
  REFUND
  API
}

enum AcquisitionSourceChannel {
  FACEBOOK
  TIKTOK
  SALES
  POSTER
  TELEGRAM
  OTHER
  DIRECT_TELEGRAM
}

enum AcquisitionInviteStatus {
  ACTIVE
  INACTIVE
}

enum SalesLeadStatus {
  NEW
  FOLLOWING
  WAITING_TELEGRAM
  APPLIED
  ACTIVATED
  LOST
}

enum SalesLeadTokenPurpose {
  APPLICATION
  SUPPORT
}

enum SalesLeadRateAction {
  LEAD_SUBMIT
  APPLICANT_CLAIM
  APPLICATION_SUBMIT
}

enum SalesLeadRateScope {
  PHONE
  TELEGRAM
  INVITE
  IP
  APPLICATION_TOKEN
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("ACTIVE")
  tier      String   @default("LITE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores                      Store[]
  users                       User[]
  products                    Product[]
  marketingProductPages       MarketingProductPage[]
  sales                       SaleRecord[]
  logs                        OperationLog[]
  bindTokens                  BindToken[]
  storeAiFeatureConfigs       StoreAiFeatureConfig[]
  offlineSaleSyncMaps         OfflineSaleSyncMap[]
  members                     Member[]
  memberBalanceLedgers        MemberBalanceLedger[]
  memberTelegramBindTokens    MemberTelegramBindToken[]
  subscription                TenantSubscription?
  subscriptionEvents          SubscriptionEvent[]
  desktopDevices              DesktopDevice[]
  browserPosDevices           BrowserPosDevice[]
  browserPosBindingDeliveries BrowserPosBindingDelivery[]
  cashierSaleIdempotencies    CashierSaleIdempotency[]
  desktopActivationPins       DesktopActivationPin[]
  desktopActivationAudits     DesktopActivationAudit[]
  computerBindings            ComputerBinding[]
  computerBindingAudits       ComputerBindingAudit[]
}

model TenantSubscription {
  id                     String    @id @default(cuid())
  tenantId               String    @unique
  status                 String
  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  currentPeriodStartedAt DateTime?
  currentPeriodEndsAt    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events SubscriptionEvent[]
}

model SubscriptionEvent {
  id                   String    @id @default(cuid())
  tenantId             String
  subscriptionId       String
  eventType            String
  previousStatus       String?
  nextStatus           String?
  previousPeriodEndsAt DateTime?
  nextPeriodEndsAt     DateTime?
  monthsAdded          Int?
  amount               Decimal?
  currency             String?
  paymentReference     String?
  note                 String?
  operatorId           String
  idempotencyKey       String    @unique
  createdAt            DateTime  @default(now())

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([subscriptionId, createdAt])
}

model Store {
  id                 String      @id @default(cuid())
  tenantId           String
  code               String      @unique
  name               String
  status             StoreStatus @default(ACTIVE)
  checkoutMode       String      @default("DIRECT_PAYMENT") // DIRECT_PAYMENT | DEFERRED_PAYMENT
  currencyCode       String      @default("USD") // USD | XAF
  businessType       String      @default("GENERAL") // FOOD | RETAIL | SERVICE | GENERAL
  printKitchenTicket Boolean     @default(false)
  bannerUrl          String? // 顾客页头图访问 URL（指向内部图片端点）
  bannerData         String?     @db.Text // 头图 base64 数据（data:image/...;base64,...）
  announcement       String? // 公告文本
  promoText          String? // 活动文案
  contactPhone       String? // 顾客公开联系电话
  contactTelegram    String? // 顾客公开 Telegram 用户名或链接
  contactWhatsApp    String? // 顾客公开 WhatsApp 电话或链接
  storeAddress       String?     @db.Text // 顾客公开门店地址
  storeLat           Float? // 顾客公开门店纬度
  storeLng           Float? // 顾客公开门店经度
  eLifeFeatured      Boolean     @default(false) // E-Life 首页「为你推荐」运营位
  eLifeFeaturedSort  Int         @default(0) // 推荐排序，数字越小排越前
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant                      Tenant                      @relation(fields: [tenantId], references: [id])
  userRoles                   UserStoreRole[]
  sales                       SaleRecord[]
  logs                        OperationLog[]
  bindTokens                  BindToken[]
  campaignLinks               CampaignLink[]
  creators                    Creator[]
  marketingProductPages       MarketingProductPage[]
  aiFeatureConfigs            StoreAiFeatureConfig[]
  offlineSaleSyncMaps         OfflineSaleSyncMap[]
  members                     Member[]
  memberBalanceLedgers        MemberBalanceLedger[]
  memberTelegramBindTokens    MemberTelegramBindToken[]
  customerJourneyEvents       CustomerJourneyEvent[]
  desktopDevices              DesktopDevice[]
  browserPosDevices           BrowserPosDevice[]
  browserPosBindingDeliveries BrowserPosBindingDelivery[]
  cashierSaleIdempotencies    CashierSaleIdempotency[]
  desktopActivationPins       DesktopActivationPin[]
  desktopActivationAudits     DesktopActivationAudit[]
  computerBindings            ComputerBinding[]
  computerBindingAudits       ComputerBindingAudit[]
  sourceApplication           StoreApplication?           @relation("StoreApplicationCreatedStore")

  @@unique([id, tenantId])
  @@index([tenantId])
}

model StoreAiFeatureConfig {
  id                  String    @id @default(cuid())
  tenantId            String
  storeId             String
  featureKey          String
  enabled             Boolean   @default(true)
  dailyLimitOverride  Int?
  trialUntil          DateTime?
  opsNote             String?   @db.Text
  updatedByOpsAdminId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId, featureKey])
  @@index([tenantId])
  @@index([storeId])
}

model User {
  id          String     @id @default(cuid())
  tenantId    String
  username    String
  displayName String
  role        UserRole
  status      UserStatus @default(ACTIVE)
  telegramId  String?
  staffNumber Int? // null for OWNER; sequential (1,2,3…) for STAFF within tenant
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  storeRoles               UserStoreRole[]
  sales                    SaleRecord[]
  logs                     OperationLog[]
  memberBalanceLedgers     MemberBalanceLedger[]
  memberTelegramBindTokens MemberTelegramBindToken[]
  revokedDesktopDevices    DesktopDevice[]           @relation("DesktopDeviceRevokedBy")
  issuedBrowserPosDevices  BrowserPosDevice[]        @relation("BrowserPosDeviceIssuedBy")
  revokedBrowserPosDevices BrowserPosDevice[]        @relation("BrowserPosDeviceRevokedBy")
  createdActivationPins    DesktopActivationPin[]    @relation("DesktopActivationPinCreatedByUser")
  desktopActivationAudits  DesktopActivationAudit[]  @relation("DesktopActivationAuditUserActor")
  decidedComputerBindings  ComputerBinding[]         @relation("ComputerBindingDecidedBy")
  disabledComputerBindings ComputerBinding[]         @relation("ComputerBindingDisabledBy")
  computerBindingAudits    ComputerBindingAudit[]    @relation("ComputerBindingAuditUserActor")

  @@unique([tenantId, username])
  @@index([tenantId])
}

model UserStoreRole {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  storeId   String
  role      UserRole
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
  @@index([tenantId])
  @@index([storeId])
}

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  parentId  String? // null = 一级分类；non-null = 二级分类
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@index([tenantId])
  @@index([tenantId, parentId])
}

model Product {
  id               String        @id @default(cuid())
  tenantId         String
  barcode          String
  sku              String?
  name             String
  spec             String?
  sellPrice        Decimal       @db.Decimal(12, 2)
  discountPrice    Decimal?      @db.Decimal(12, 2)
  discountEnabled  Boolean       @default(false)
  status           ProductStatus @default(ACTIVE)
  categoryId       String?
  nameZh           String?
  nameEn           String?
  nameKm           String?
  descZh           String?
  descEn           String?
  descKm           String?
  imageUrl         String? // 商品主图公开访问 URL（Supabase Storage public bucket）
  imageStorageKey  String? // Storage 对象 key，用于删除/替换
  imageUrls        String?       @db.Text // JSON: 最多 3 张商品图 URL；第一张同步到 imageUrl
  imageStorageKeys String?       @db.Text // JSON: 与 imageUrls 对应的 Storage object keys
  imageUpdatedAt   DateTime? // 图片最近一次更新时间
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  category              ProductCategory?       @relation(fields: [categoryId], references: [id])
  sales                 SaleRecord[]
  marketingProductPages MarketingProductPage[]

  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([name])
  @@index([categoryId])
}

model MarketingProductPage {
  id              String                            @id @default(cuid())
  tenantId        String
  storeId         String
  productId       String
  slug            String                            @unique
  status          MarketingProductPageStatus        @default(DRAFT)
  templateType    MarketingProductPageTemplateType?
  title           String?
  titleZh         String?
  titleEn         String?
  titleKm         String?
  subtitle        String?
  heroImageUrl    String?
  heroVideoUrl    String?
  salePrice       Decimal?                          @db.Decimal(12, 2)
  originalPrice   Decimal?                          @db.Decimal(12, 2)
  soldCount       Int?
  feature1        String?
  feature2        String?
  feature3        String?
  feature4        String?
  feature5        String?
  feature1Zh      String?
  feature2Zh      String?
  feature3Zh      String?
  feature4Zh      String?
  feature5Zh      String?
  feature1En      String?
  feature2En      String?
  feature3En      String?
  feature4En      String?
  feature5En      String?
  feature1Km      String?
  feature2Km      String?
  feature3Km      String?
  feature4Km      String?
  feature5Km      String?
  enableCountdown Boolean                           @default(false)
  detailImage1    String?
  detailImage2    String?
  detailImage3    String?
  reviewImage1    String?
  reviewImage2    String?
  reviewImage3    String?
  buttonText      String?
  buttonTextZh    String?
  buttonTextEn    String?
  buttonTextKm    String?
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([productId])
}

model SaleRecord {
  id                   String  @id @default(cuid())
  tenantId             String
  storeId              String
  operatorUserId       String
  transactionActorType String?
  transactionActorId   String?
  authorizedByUserId   String?

  recordNo String       @unique
  saleType SaleType
  status   RecordStatus @default(COMPLETED)

  productId           String?
  barcode             String
  productNameSnapshot String
  specSnapshot        String?
  unitPrice           Decimal @db.Decimal(12, 2)
  quantity            Decimal @db.Decimal(12, 2)
  lineAmount          Decimal @db.Decimal(12, 2)

  orderNo String? // 一次结账所有明细行共享此单号；null = 历史单行记录

  source                          String?
  offlineOrderId                  String?
  offlineDeviceId                 String?
  offlineCreatedAtLocal           String?
  offlineCreatedAtClientTimestamp DateTime?
  offlineSyncedAt                 DateTime?
  offlineSyncStatus               String?
  inventoryException              String?
  memberId                        String?
  memberBalanceUsed               Decimal   @default(0) @db.Decimal(12, 2)

  originalSaleRecordId String?
  refundedQty          Decimal? @db.Decimal(12, 2)
  refundReason         String?
  remark               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  store        Store    @relation(fields: [storeId], references: [id])
  operatorUser User     @relation(fields: [operatorUserId], references: [id])
  product      Product? @relation(fields: [productId], references: [id])
  member       Member?  @relation(fields: [memberId], references: [id])

  originalSaleRecord SaleRecord?  @relation("RefundRelation", fields: [originalSaleRecordId], references: [id])
  refundChildren     SaleRecord[] @relation("RefundRelation")

  logs            OperationLog[]
  offlineSyncMaps OfflineSaleSyncMap[]

  @@index([tenantId, createdAt])
  @@index([storeId, createdAt])
  @@index([operatorUserId, createdAt])
  @@index([transactionActorType, transactionActorId])
  @@index([saleType, createdAt])
  @@index([originalSaleRecordId])
  @@index([barcode])
  @@index([source])
  @@index([offlineOrderId])
  @@index([offlineDeviceId])
  @@index([memberId])
}

model Member {
  id               String       @id @default(cuid())
  tenantId         String
  storeId          String
  memberCode       String
  name             String
  phone            String?
  normalizedPhone  String?
  telegramId       String?
  telegramUsername String?
  balance          Decimal      @default(0) @db.Decimal(12, 2)
  status           MemberStatus @default(ACTIVE)
  note             String?      @db.Text
  importBatchId    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  store              Store                     @relation(fields: [storeId], references: [id])
  ledgers            MemberBalanceLedger[]
  sales              SaleRecord[]
  telegramBindTokens MemberTelegramBindToken[]

  @@unique([tenantId, storeId, memberCode])
  @@unique([tenantId, storeId, normalizedPhone])
  @@unique([tenantId, storeId, telegramId])
  @@index([tenantId])
  @@index([storeId])
  @@index([status])
}

model MemberBalanceLedger {
  id                   String                        @id @default(cuid())
  tenantId             String
  storeId              String
  memberId             String
  type                 MemberBalanceLedgerType
  sourceType           MemberBalanceLedgerSourceType
  sourceId             String?
  amount               Decimal                       @db.Decimal(12, 2)
  balanceBefore        Decimal                       @db.Decimal(12, 2)
  balanceAfter         Decimal                       @db.Decimal(12, 2)
  operatorUserId       String?
  transactionActorType String?
  transactionActorId   String?
  authorizedByUserId   String?
  note                 String?                       @db.Text
  createdAt            DateTime                      @default(now())

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  store        Store  @relation(fields: [storeId], references: [id])
  member       Member @relation(fields: [memberId], references: [id])
  operatorUser User?  @relation(fields: [operatorUserId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([memberId])
  @@index([type])
  @@index([sourceType])
  @@index([sourceId])
  @@index([operatorUserId])
  @@index([transactionActorType, transactionActorId])
  @@index([createdAt])
}

model MemberTelegramBindToken {
  id              String    @id @default(cuid())
  tenantId        String
  storeId         String
  memberId        String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  store         Store  @relation(fields: [storeId], references: [id])
  member        Member @relation(fields: [memberId], references: [id])
  createdByUser User?  @relation(fields: [createdByUserId], references: [id])

  @@index([tenantId, storeId, memberId])
  @@index([tenantId, storeId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdByUserId])
}

model OfflineSaleSyncMap {
  id               String    @id @default(cuid())
  tenantId         String
  storeId          String
  deviceId         String
  offlineOrderId   String
  saleRecordId     String?
  status           String    @default("PENDING")
  syncedAt         DateTime?
  rawPayloadHash   String?
  lastErrorCode    String?
  lastErrorMessage String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  store      Store       @relation(fields: [storeId], references: [id])
  saleRecord SaleRecord? @relation(fields: [saleRecordId], references: [id])

  @@unique([storeId, deviceId, offlineOrderId])
  @@index([tenantId])
  @@index([storeId])
  @@index([saleRecordId])
  @@index([status])
  @@index([createdAt])
}

model MerchantPaymentConfig {
  id                 String   @id @default(cuid())
  tenantId           String
  storeId            String? // null = tenant 级默认配置
  provider           String   @default("BAKONG_KHQR") // BAKONG_KHQR | ...
  merchantId         String? // null = 纯图片模式
  merchantName       String? // null = 纯图片模式
  merchantAccountRef String? // null = 纯图片模式；Bakong 账户手机号 / ref
  currency           String   @default("USD") // USD | KHR
  khqrEnabled        Boolean  @default(true)
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)
  khqrImageUrl       String?  @db.Text // base64 data URL (老板通过 Telegram 上传)
  uploadedByUserId   String? // 上传者 User.id
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  paymentIntents PaymentIntent[]

  @@index([tenantId])
  @@index([tenantId, storeId])
}

model PaymentIntent {
  id                   String        @id @default(cuid())
  tenantId             String
  storeId              String
  operatorUserId       String
  transactionActorType String?
  transactionActorId   String?
  authorizedByUserId   String?
  orderNo              String        @unique
  paymentMethod        PaymentMethod
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(12, 2)
  khqrPayload          String? // EMV QR string; null for CASH
  provider             String? // from MerchantPaymentConfig.provider
  merchantConfigId     String? // FK to MerchantPaymentConfig
  paidAt               DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  merchantConfig MerchantPaymentConfig? @relation(fields: [merchantConfigId], references: [id])

  @@index([tenantId, createdAt])
  @@index([orderNo])
  @@index([status])
  @@index([merchantConfigId])
  @@index([transactionActorType, transactionActorId])
}

model CashierSaleIdempotency {
  id                 String   @id @default(cuid())
  tenantId           String
  storeId            String
  actorType          String
  actorId            String
  operation          String
  idempotencyKey     String
  payloadFingerprint String
  status             String   @default("PROCESSING")
  resultSnapshot     Json?
  orderNo            String?
  paymentIntentId    String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, storeId, actorType, actorId, operation, idempotencyKey], map: "CashierSaleIdempotency_operation_key")
  @@index([tenantId, storeId, expiresAt], map: "CashierSaleIdempotency_tenant_store_expiresAt_idx")
  @@index([orderNo])
  @@index([paymentIntentId])
}

model PaymentTransaction {
  id                String    @id @default(cuid())
  tenantId          String
  storeId           String
  customerOrderId   String?
  salesRecordId     String?
  provider          String
  method            String
  trxId             String    @unique
  providerTrxCode   String?
  amount            Decimal   @db.Decimal(12, 2)
  currency          String
  status            String    @default("PENDING")
  deepLinkUrl       String?   @db.Text
  callbackUrl       String?   @db.Text
  requestPayload    Json?
  responsePayload   Json?
  callbackPayload   Json?
  inquiryPayload    Json?
  errorCode         String?
  errorMessage      String?
  signatureVerified Boolean   @default(false)
  paidAt            DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, createdAt])
  @@index([storeId, createdAt])
  @@index([customerOrderId])
  @@index([salesRecordId])
  @@index([status])
}

model BindToken {
  id        String   @id @default(cuid())
  token     String   @unique
  tenantId  String
  storeId   String
  role      UserRole
  label     String? // 人工备注，如"总店员工邀请"
  expiresAt DateTime
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  status    String   @default("ACTIVE") // ACTIVE | REVOKED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([token])
}

model OperationLog {
  id       String  @id @default(cuid())
  tenantId String
  storeId  String?
  userId   String?

  actionType      String
  targetType      String
  targetId        String?
  requestId       String?
  status          LogStatus
  message         String?
  payloadSnapshot Json?
  createdAt       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store? @relation(fields: [storeId], references: [id])
